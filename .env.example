# Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=traffic_accidents
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/traffic_accidents
SQLITE_FALLBACK_PATH=data/traffic_accidents.db
# Leave DATABASE_URL empty to skip PostgreSQL and use the SQLite fallback directly

# UK DfT Road Safety source (downloaded automatically into datasets/ if missing)
DFT_COLLISION_URL=https://data.dft.gov.uk/road-accidents-safety-data/dft-road-casualty-statistics-collision-last-5-years.csv
DFT_COLLISION_FILE=datasets/dft-road-casualty-statistics-collision-last-5-years.csv
# Max new collisions per ingestion run (empty = all unseen rows)
ACCIDENT_BATCH_SIZE=

# Open-Meteo Weather API
OPEN_METEO_BASE_URL=https://archive-api.open-meteo.com/v1/archive
OPEN_METEO_FORECAST_URL=https://api.open-meteo.com/v1/forecast
# Weather grid cell size in degrees for the accident-weather join
WEATHER_GRID_DEG=1.0

# MLflow Tracking
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_NAME=traffic-accident-severity-prediction
MLFLOW_REGISTERED_MODEL=accident-severity-classifier

# FastAPI Model Serving
API_HOST=0.0.0.0
API_PORT=8000
MODEL_PATH=models/accident_severity_model.joblib
LOG_PREDICTIONS=true

# Airflow Configuration
AIRFLOW_UID=50000
AIRFLOW_HOME=./airflow
